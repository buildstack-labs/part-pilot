# ── Database (required by data-engine + Next.js app) ─────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/partpilot

# ── Firecrawl — supplier price scraping ───────────────────────────────────────
# Get a key: https://www.firecrawl.dev/app/api-keys
FIRECRAWL_API_KEY=

# Optional: delay between scrape requests (default 2500ms)
# FIRECRAWL_SCRAPE_DELAY_MS=2500

# ── Data Engine sync scheduler ────────────────────────────────────────────────
# Cron schedule (default: every 8 hours)
# SYNC_CRON_SCHEDULE=0 */8 * * *

# Run a full sync immediately on engine startup (default false)
# SYNC_ON_START=false

# Limit sync scope (comma-separated supplier IDs or OEM numbers)
# SYNC_SUPPLIERS=partsouq,sparekorea
# SYNC_PARTS=26300-35505,28113-2H000

# HEAD request timeout for URL validation (default 8000ms)
# URL_VALIDATOR_TIMEOUT_MS=8000

# ── eBay Browse API (future) ──────────────────────────────────────────────────
# EBAY_BROWSE_API_ENABLED=false
