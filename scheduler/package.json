{
  "name": "@partpilot/scheduler",
  "version": "0.1.0",
  "private": true,
  "main": "./src/index.ts",
  "scripts": {
    "prepare:collectors": "npm install --prefix ../data-collectors --no-audit --no-fund",
    "dev":   "npm run prepare:collectors && tsx watch src/index.ts",
    "start": "npm run prepare:collectors && tsx src/index.ts",
    "sync":  "npm run prepare:collectors && tsx src/sync-once.ts",
    "lint":  "tsc --noEmit"
  },
  "dependencies": {
    "@partpilot/data-collectors": "file:../data-collectors",
    "node-cron": "^3.0.3"
  },
  "devDependencies": {
    "@types/node":      "^20",
    "@types/node-cron": "^3.0.11",
    "tsx":              "^4.19.4",
    "typescript":       "^5"
  }
}
